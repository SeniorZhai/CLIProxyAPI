# Use the exact public origin used by your browser, without a path.
# Public deployments require HTTPS. HTTP is supported on localhost for testing.
CPA_PUBLIC_URL=http://localhost:8318
CPA_PORT=8318

# Used only when creating the administrator for the first time.
CPA_ADMIN_USERNAME=admin
# Omit CPA_ADMIN_PASSWORD to generate a random password (recommended).
# CPA_ADMIN_PASSWORD=
